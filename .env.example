# OAuth 2.0 client ID (type: "Chrome extension") from Google Cloud Console.
# Required for Google Sheets access. See README -> "Google Cloud setup".
VITE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: public key of the extension (from the Chrome Web Store dashboard or
# `openssl rsa -pubout`). Pins the extension ID so it matches the OAuth client.
# VITE_EXTENSION_KEY=
